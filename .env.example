# Copia a .env.local y completa. Nunca commitear valores reales.
# Entorno de la app: development | test | production
APP_ENV=development
APP_URL=http://localhost:3000

# Supabase (proyecto único en línea). Ver docs/supabase-setup.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Jamás con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
# Token de acceso personal de Supabase, solo para `pnpm db:types` (no lo lee la app)
SUPABASE_ACCESS_TOKEN=

# Secreto para firmar/hashear códigos de verificación (mínimo 32 caracteres). Generar con: openssl rand -hex 32
EMAIL_CODE_SECRET=

# Correo saliente por SMTP (desarrollo: Gmail 465 seguro con contraseña de aplicación). Ver docs/spec/email.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM_NAME=Zlotify
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# true cuando activaste Captcha protection en Supabase (docs/supabase-setup.md). Entonces el token de Turnstile
# de los inicios de sesión lo valida Supabase y no se verifica dos veces (los tokens son de un solo uso).
SUPABASE_CAPTCHA_ENABLED=false

# Solo pruebas de concurrencia (tests/db/concurrency.test.ts): compradores simultáneos (por defecto 50)
# CONCURRENCY_BUYERS=50

# Cumplimiento (S8): secreto del endpoint que ejecuta los plazos y envía los correos pendientes.
# Generar con `openssl rand -hex 32`. Un programador externo lo invoca cada 5 min (docs/supabase-setup.md).
CRON_SECRET=
